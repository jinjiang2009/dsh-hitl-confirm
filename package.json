{
  "name": "dsh-hitl-confirm",
  "version": "0.1.0",
  "description": "Human-in-the-loop (HITL) confirmation for DeepSeek Harness: when the agent cannot decide among candidate options (a/b/c …), the run pauses and a visible modal in the web UI shows the options together with their context; the human picks one and the execution chain resumes with that choice.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinjiang2009/dsh-hitl-confirm.git"
  },
  "homepage": "https://github.com/jinjiang2009/dsh-hitl-confirm#readme",
  "bugs": {
    "url": "https://github.com/jinjiang2009/dsh-hitl-confirm/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "node --check src/index.js && node --check src/client/index.js && node --check tsdown.config.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "hitl",
    "human-in-the-loop",
    "confirmation",
    "modal",
    "approval"
  ],
  "license": "MIT",
  "author": "jinjiang2009",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "^0.1.1-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.14"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
